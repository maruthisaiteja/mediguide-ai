# ─────────────────────────────────────────────────────────────────────────────
# MediGuide AI — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# SETUP INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual values in .env
#   3. NEVER commit .env to version control (it's in .gitignore)
#
# Get your Google API Key at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Your Google Gemini API key (required for ADK agent inference)
GOOGLE_API_KEY=your_google_api_key_here

# ── MCP SERVER CONFIGURATION ──────────────────────────────────────────────────

# Port for the MCP Medical Knowledge Server
MCP_SERVER_PORT=8080

# Host for the MCP server (0.0.0.0 for all interfaces, 127.0.0.1 for local only)
MCP_SERVER_HOST=0.0.0.0

# URL that the ADK agent uses to connect to the MCP server
MCP_SERVER_URL=http://localhost:8080

# ── AGENT CONFIGURATION ───────────────────────────────────────────────────────

# Gemini model to use (gemini-2.0-flash recommended for speed, gemini-1.5-pro for quality)
GEMINI_MODEL=gemini-2.0-flash

# Agent temperature (0.0 = deterministic, 1.0 = creative) — use low for medical accuracy
AGENT_TEMPERATURE=0.2

# Maximum tokens in agent responses
AGENT_MAX_OUTPUT_TOKENS=2048

# ── SECURITY CONFIGURATION ────────────────────────────────────────────────────

# Enable strict security mode (blocks suspicious inputs) — recommended: true
SECURITY_STRICT_MODE=true

# Enable security audit logging
SECURITY_AUDIT_LOGGING=true

# ── APPLICATION CONFIGURATION ─────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Application environment: development, staging, production
APP_ENV=development

# ── OPTIONAL INTEGRATIONS ─────────────────────────────────────────────────────

# Google Cloud Project ID (for Cloud Run deployment)
# GOOGLE_CLOUD_PROJECT=your-project-id

# Google Cloud region for deployment
# GOOGLE_CLOUD_REGION=us-central1
